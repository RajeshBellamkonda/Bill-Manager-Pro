rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the Cloud Function (admin SDK) reads these.
    // The app can create notification docs, and delete them by ID (IDs embed bill id, date and
    // token suffix). Client queries/reads are not allowed, so the app tracks its own doc IDs.
    match /scheduled_notifications/{docId} {
      allow create: if request.resource.data.token is string
                    && request.resource.data.token.size() > 0;
      allow delete: if resource.data.token is string;
      allow read, update: if false; // admin SDK only
    }
    // Temporary ping doc used by testConnection()
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
